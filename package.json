{
  "name": "math-method-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsx scripts/validate.ts && tsc --noEmit && vite build",
