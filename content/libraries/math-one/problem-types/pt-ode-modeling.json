      "id": "pt-ode-modeling-formula-1",
      "title": "恒定输入与线性损耗",
      "latex": "M'=a-bM,\\ M(0)=M_0\\ \\Longrightarrow\\ M(t)=a/b+(M_0-a/b)e^{-bt}",
      "conditions": [
        "a≥0，b>0，M₀≥0，t≥0"
      ],
      "derivation": "平移N=M−a/b后N′=−bN分离；结果非负且趋a/b。",
