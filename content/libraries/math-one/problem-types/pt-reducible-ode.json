  "formulas": [
    {
      "id": "pt-reducible-ode-formula-1",
      "title": "欧拉二阶换元",
      "latex": "t=\\ln|x|,\\quad xy'=Y_t,\\quad x^2y''=Y_{tt}-Y_t",
      "conditions": [
        "x≠0且固定符号，y=Y(t)二次可导"
      ],
      "derivation": "dt/dx=1/x，先求y′=Y_t/x再求二阶。",
      "methodIds": [
        "hm-ode-euler"
      ]
    },
    {
      "id": "pt-reducible-ode-formula-2",
      "title": "缺x的降阶",
      "latex": "p(y)=y',\\quad y''=p\\frac{dp}{dy}",
      "conditions": [
        "局部以y作变量；常值解单独查"
      ],
      "derivation": "链式dp/dx=(dp/dy)y′；不可在全部转折点默认反函数存在。",
      "methodIds": [
        "hm-ode-reduction"
      ]
    }
  ],
