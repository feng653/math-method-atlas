  "formulas": [
    {
      "id": "pt-derivative-proofs-formula-1",
      "title": "切线与弦线夹界",
      "latex": "f(a)+f'(a)(x-a)\\le f(x)\\le\\frac{b-x}{b-a}f(a)+\\frac{x-a}{b-a}f(b)",
      "conditions": [
        "a<b，x∈[a,b]，f在包含[a,b]的开区间内可导且凸（特别a处导数存在）"
      ],
      "derivation": "左边用凸函数导数单调及中值定理；右边将x写为端点凸组合。",
      "methodIds": [
        "hm-convex-secant"
      ]
    }
  ],
