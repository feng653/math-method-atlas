  "formulas": [
    {
      "id": "pr-events-conditional-inference-formula-1",
      "title": "条件优势比的贝叶斯更新",
      "latex": "\\frac{P(B\\mid A)}{P(B^c\\mid A)}=\\frac{P(A\\mid B)}{P(A\\mid B^c)}\\frac{P(B)}{P(B^c)}",
      "conditions": [
        "0<P(B)<1，P(A)>0",
        "P(A|Bᶜ)>0，使显示分母非零"
      ],
      "derivation": "分别写B和Bᶜ的贝叶斯式，相除时公共证据概率P(A)消去，剩似然比乘先验比。",
      "methodIds": [
        "pr-event-bayes",
        "pr-event-conditional"
      ]
    }
  ],
