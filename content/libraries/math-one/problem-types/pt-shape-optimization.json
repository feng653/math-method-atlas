      "id": "pt-shape-optimization-formula-1",
      "title": "曲率圆心",
      "latex": "C=\\left(x-\\frac{f'(1+(f')^2)}{f''},\\ f+\\frac{1+(f')^2}{f''}\\right)",
      "conditions": [
