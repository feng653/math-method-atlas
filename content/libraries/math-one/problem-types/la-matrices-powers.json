  "formulas": [
    {
      "id": "la-matrices-powers-formula-1",
      "title": "秩一矩阵的正整数幂",
      "latex": "A=uv^T\\quad\\Longrightarrow\\quad A^k=(v^Tu)^{k-1}uv^T\\quad(k\\ge1)",
      "conditions": [
        "u,v为同维列向量",
        "k=1时标量零次幂约定为1，或单独写A¹=A"
      ],
      "derivation": "A²=u(vᵀu)vᵀ；再用归纳法每次右乘A多出一个标量vᵀu。若vᵀu=0则所有k≥2的幂为零。",
      "methodIds": [
        "la-rank-factor-power",
        "la-matrix-power"
      ]
    }
  ],
