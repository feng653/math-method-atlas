  "formulas": [
    {
      "id": "la-matrices-equations-formula-1",
      "title": "两侧矩阵方程的解",
      "latex": "AXB=C\\quad\\Longrightarrow\\quad X=A^{-1}CB^{-1}",
      "conditions": [
        "A,B分别为可逆方阵",
        "C和X尺寸与乘积相容"
      ],
      "derivation": "先左乘A⁻¹消去A，再右乘B⁻¹消去B；代回由结合律得到C，逆运算同时证明唯一。",
      "methodIds": [
        "la-matrix-inverse",
        "la-matrix-product"
      ]
    }
  ],
