      "id": "la-systems-classify-formula-1",
      "title": "相容系统解集的维数",
      "latex": "\\mathcal S=x_p+\\ker A,\\qquad \\dim\\mathcal S=n-\\operatorname{rank}A",
      "conditions": [
        "A有n列且Ax=b相容",
