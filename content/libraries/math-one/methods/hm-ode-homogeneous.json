    "hm-ode-separable",
    "hm-ode-reduction"
  ],
  "topicIds": [
    "ode-ode-homogeneous"
  ],
  "status": "draft",
  "learning": {
    "intuition": "若一阶方程的右端只依赖 y/x，把这个比值整体记成新变量，原方程常能分离变量。",
    "symbols": [
      {
        "symbol": "微分方程",
        "meaning": "微分方程把未知函数和它的导数联系起来。方程的阶是出现的最高导数阶数。求解后应代回方程检查。"
      },
      {
        "symbol": "分数线",
        "meaning": "分子除以分母；使用分式时需检查分母不为零。"
      }
    ],
    "explanation": [
      "y=ux 的导数是 u+xu′，不能漏掉乘积求导的第一项。"
    ]
  }
