  "formula": "S^2=\\frac{\\sum_i(X_i-\\bar X)^2}{n-1},\\quad F_n(x)=\\frac1n\\sum_i\\mathbf1_{X_i\\le x}",
  "pitfalls": [
    "统计量不能包含未知总体参数"
  ],
  "example": {
    "prompt": "自编例题：样本为 1,2,3，求均值、S² 和 Fn(2)。",
    "solution": "均值 2，S²=(1+0+1)/2=1，Fn(2)=2/3。"
  },
